# Base de données - PostgreSQL Local (Docker)
DATABASE_URL=postgresql://verbatim_user:verbatim_password_change_me@localhost:5432/verbatim_analysis

# Base de données - Supabase (optionnel)
# Activer USE_SUPABASE=true pour utiliser Supabase au lieu de PostgreSQL local
USE_SUPABASE=true
SUPABASE_URL=https://wdtxtsgvnxepmbxjzeem.supabase.co
SUPABASE_KEY=your-anon-or-service-key-here
SUPABASE_DB_URL=postgresql://postgres.wdtxtsgvnxepmbxjzeem:[YOUR-DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-test-key
OPENAI_MODEL=gpt-4-turbo-preview

# Application
DEBUG=true
LOG_LEVEL=INFO

# Limites
MAX_VERBATIMS=30000
MAX_CHUNKS=500
CHUNK_SIZE=200
SAMPLE_SIZE_RAPID=750

# Timeouts
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Parallélisme
LLM_PARALLEL_CALLS=10

# Seuils
DEDUP_THRESHOLD_DEFAULT=0.90
FUZZY_MERGE_THRESHOLD=0.92
JACCARD_MERGE_THRESHOLD=0.75
NEGATION_WINDOW=3

# Sampling
MIN_PER_STRATUM=30
CAP_PER_STRATUM=300
SAMPLING_SEED=42

# GIDA
GIDA_VERSION=2026.01
GIDA_PATH=data/gida/gida_2026_01.json

# Alertes
CHUNK_WARNING_THRESHOLD=100
CHUNK_BLOCKING_THRESHOLD=500
